# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local
*.tsbuildinfo

# Native wrappers.
#
# `android/` is committed, unlike what Phase 0 assumed. It is not purely
# generated: `cap add` scaffolds it once and everything after that — the
# manifest, the launcher icons, the signing config — lives there and survives
# no regeneration. Its own `android/.gitignore` already excludes the parts that
# genuinely are output (the copied `dist/`, the generated Capacitor config, and
# every build directory), so what is tracked is only the project itself.
#
# `src-tauri/` is committed for the same reason; only its build output is not.
ios/
src-tauri/target/
src-tauri/gen/

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env / secrets
.env
.env.*
!.env.example

# Test output
coverage/

# ---------------------------------------------------------------
# Personal financial data. This repository is PUBLIC.
# Exports from the old app live here for the migration importer to
# be developed against, but must never be committed.
# ---------------------------------------------------------------
migration-data/
*.xls
*.xlsx
*.pdf
